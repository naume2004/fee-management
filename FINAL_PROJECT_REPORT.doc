<tr><td>student_id</td><td>VARCHAR(20)</td><td>FOREIGN KEY REFERENCES students(student_id)</td><td>Associated student</td></tr>
<tr><td>appointment_date</td><td>DATE</td><td>NOT NULL</td><td>Scheduled appointment date</td></tr>
<tr><td>appointment_time</td><td>TIME</td><td>NOT NULL</td><td>Scheduled appointment time</td></tr>
<tr><td>purpose</td><td>VARCHAR(200)</td><td>NOT NULL</td><td>Purpose of visit</td></tr>
<tr><td>notes</td><td>TEXT</td><td>DEFAULT NULL</td><td>Additional notes</td></tr>
<tr><td>status</td><td>VARCHAR(20)</td><td>NOT NULL, DEFAULT 'Scheduled'</td><td>Appointment status (Scheduled/Completed/Cancelled)</td></tr>
<tr><td>created_at</td><td>TIMESTAMP</td><td>DEFAULT CURRENT_TIMESTAMP</td><td>Booking timestamp</td></tr>
</table>

