<tr><td>payment_date</td><td>DATETIME</td><td>DEFAULT NULL</td><td>Date payment was made</td></tr>
<tr><td>created_at</td><td>TIMESTAMP</td><td>DEFAULT CURRENT_TIMESTAMP</td><td>Record creation timestamp</td></tr>
</table>

