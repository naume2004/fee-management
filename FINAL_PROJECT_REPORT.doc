<tr><td>fee_type</td><td>VARCHAR(50)</td><td>NOT NULL</td><td>Fee category (Tuition, Development, Sports, etc.)</td></tr>
<tr><td>status</td><td>VARCHAR(20)</td><td>NOT NULL, DEFAULT 'Pending'</td><td>Payment status (Paid/Pending)</td></tr>
