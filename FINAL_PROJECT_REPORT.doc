<tr><td>name</td><td>VARCHAR(100)</td><td>NOT NULL</td><td>Staff full name</td></tr>
<tr><td>role</td><td>VARCHAR(50)</td><td>NOT NULL, DEFAULT 'admin'</td><td>User role</td></tr>
<tr><td>created_at</td><td>TIMESTAMP</td><td>DEFAULT CURRENT_TIMESTAMP</td><td>Account creation timestamp</td></tr>
</table>

